# Copy this file to ".env" (same folder as server/package.json) and fill in real values.
# Do NOT commit ".env" to git.

# Secret "pepper" appended to passwords before bcrypt hashing.
# Generate on Windows PowerShell:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PASSWORD_PEPPER=replace_with_random_64_hex_chars

# bcrypt cost factor (higher = slower, more secure). Typical: 12
BCRYPT_COST=12